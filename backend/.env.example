# Copy this file to .env and fill in real values

# Optional locally — leave blank to use a SQLite file at backend/app.db.
# Required in production (e.g. on Render): that filesystem is ephemeral
# and gets wiped on every deploy/restart, so SQLite there doesn't persist.
# Point this at a hosted Postgres instead (Supabase/Neon both have a free
# tier) -- e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Required — get from console.groq.com (API Keys page)
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the default Groq model (openai/gpt-oss-120b)
GROQ_MODEL=

# Optional — leave blank to run in "stub" mode (prints to console
# instead of sending real WhatsApp messages)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Required once you connect a real webhook — any string you make up.
# Enter the same value in Meta's App Dashboard webhook setup form; Meta
# echoes it back on the GET verification handshake to confirm you control
# this endpoint.
WHATSAPP_VERIFY_TOKEN=

# Required once you connect a real webhook — the Meta App's "App Secret"
# (App Dashboard -> Settings -> Basic). NOT the same as WHATSAPP_TOKEN or
# WHATSAPP_VERIFY_TOKEN above. Used to verify Meta's X-Hub-Signature-256
# header on every webhook POST -- left blank, that check is skipped
# entirely (fine for local testing with curl/TestClient, NOT fine once a
# real webhook URL is public, since anyone who finds it could otherwise
# post fabricated customer messages that each trigger a paid Groq call).
WHATSAPP_APP_SECRET=

# Optional -- caps how many WhatsApp webhook messages are processed per
# minute, from one phone number / in total, before the rest are dropped
# (see backend/ratelimit.py). Defaults (10 per phone, 60 total) are
# generous for real conversations and only kick in on a bug or abuse.
WEBHOOK_RATE_LIMIT_PER_PHONE=
WEBHOOK_RATE_LIMIT_GLOBAL=

# Optional — install LibreOffice instead if you can (works everywhere, no
# flakiness). Only set this to "true" if you've confirmed docx2pdf/MS Word
# is stable on your machine — it's known to crash or hang on some Word
# versions, since it drives Word via AppleScript automation.
ENABLE_WORD_PDF_FALLBACK=

# Session cookie signing secret — change this to a random string before
# any real deployment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=dev-only-change-this-secret

# Optional — sets the default admin account created on first run.
# If left blank, a random password is generated and printed to the
# console once. Either way, create your own account afterwards with
# scripts/create_admin.py and remove this default one.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
