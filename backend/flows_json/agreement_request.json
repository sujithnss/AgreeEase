{
  "version": "6.0",
  "screens": [
    {
      "id": "WELCOME",
      "title": "AgreeEase",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Let's set up your agreement / നിങ്ങളുടെ കരാർ തയ്യാറാക്കാം"
          },
          {
            "type": "TextBody",
            "text": "We'll ask a few quick questions to prepare your agreement. / നിങ്ങളുടെ കരാർ തയ്യാറാക്കാൻ ഞങ്ങൾ ചില ചോദ്യങ്ങൾ ചോദിക്കും."
          },
          {
            "type": "Footer",
            "label": "Continue / തുടരുക",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "TYPE" },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "TYPE",
      "title": "Type of Agreement",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "agreement_type",
            "label": "What type of agreement do you need? / ഏത് തരം കരാറാണ് വേണ്ടത്?",
            "required": true,
            "data-source": [
              { "id": "rental_agreement", "title": "Rent Home / വീട് വാടക" },
              { "id": "shop_agreement", "title": "Commercial / കട / വ്യാപാര കരാർ" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue / തുടരുക",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "LANGUAGE" },
              "payload": {
                "agreement_type": "${form.agreement_type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LANGUAGE",
      "title": "Document Language",
      "data": {
        "agreement_type": { "type": "string", "__example__": "rental_agreement" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "preferred_document_language",
            "label": "Which language should the document be in? / രേഖ ഏത് ഭാഷയിൽ വേണം?",
            "required": true,
            "data-source": [
              { "id": "english", "title": "English / ഇംഗ്ലീഷ്" },
              { "id": "malayalam", "title": "Malayalam / മലയാളം" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue / തുടരുക",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "DETAILS" },
              "payload": {
                "agreement_type": "${data.agreement_type}",
                "preferred_document_language": "${form.preferred_document_language}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Agreement Details",
      "terminal": true,
      "data": {
        "agreement_type": { "type": "string", "__example__": "rental_agreement" },
        "preferred_document_language": { "type": "string", "__example__": "malayalam" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Agreement Details / കരാർ വിവരങ്ങൾ"
          },

          { "type": "TextInput", "name": "landlord_name", "label": "House Owner / Landlord Name / വീട്ടുടമയുടെ പേര്", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "landlord_address", "label": "House Owner / Landlord Address / വീട്ടുടമയുടെ വിലാസം", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "tenant_name", "label": "Tenant Name / വാടകക്കാരന്റെ പേര്", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "tenant_address", "label": "Tenant Address / വാടകക്കാരന്റെ വിലാസം", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "security_deposit", "label": "Advance Amount (INR) / അഡ്വാൻസ് തുക (രൂപ)", "input-type": "number", "required": true },
          { "type": "TextInput", "name": "monthly_rent", "label": "Rent Amount (INR, monthly) / വാടക തുക (മാസം, രൂപ)", "input-type": "number", "required": true },
          { "type": "DatePicker", "name": "start_date", "label": "Agreement Date / കരാർ തീയതി", "required": true },

          {
            "type": "TextInput", "name": "fee_due_day",
            "label": "Rent Paid Day of Month, e.g. 5 or 10 / വാടക നൽകുന്ന ദിവസം, ഉദാ: 5 അല്ലെങ്കിൽ 10",
            "input-type": "number",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "TextInput", "name": "district",
            "label": "District / ജില്ല",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "RadioButtonsGroup", "name": "local_body_type",
            "label": "Local Body Type / തദ്ദേശ സ്ഥാപന തരം",
            "data-source": [
              { "id": "grama_panchayat", "title": "Grama Panchayat / ഗ്രാമപഞ്ചായത്ത്" },
              { "id": "municipality", "title": "Municipality / മുനിസിപ്പാലിറ്റി" },
              { "id": "corporation", "title": "Corporation / കോർപ്പറേഷൻ" }
            ],
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "TextInput", "name": "local_body_name",
            "label": "Name of Local Body / തദ്ദേശ സ്ഥാപനത്തിന്റെ പേര്",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "RadioButtonsGroup", "name": "property_type",
            "label": "Type of Property / വസ്തുവിന്റെ തരം",
            "data-source": [
              { "id": "flat", "title": "Flat / ഫ്ലാറ്റ്" },
              { "id": "apartment", "title": "Apartment / അപ്പാർട്ട്മെന്റ്" },
              { "id": "house", "title": "House / വീട്" },
              { "id": "quarters", "title": "Quarters / ക്വാർട്ടേഴ്സ്" }
            ],
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "TextInput", "name": "flat_name",
            "label": "Flat/Unit Name or Number / ഫ്ലാറ്റ്/യൂണിറ്റ് പേര് അല്ലെങ്കിൽ നമ്പർ",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'flat' || ${form.property_type} == 'apartment')`"
          },
          {
            "type": "TextInput", "name": "floor",
            "label": "Floor / നില",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'house' || ${form.property_type} == 'quarters')`"
          },
          {
            "type": "TextInput", "name": "property_address",
            "label": "Door No. / Additional Address Details, optional / ഡോർ നമ്പർ / കൂടുതൽ വിലാസ വിവരങ്ങൾ, ഓപ്ഷണൽ",
            "input-type": "text",
            "required": false,
            "visible": "`${data.agreement_type} == 'rental_agreement'`"
          },

          {
            "type": "TextInput", "name": "shop_address",
            "label": "Shop Address / കടയുടെ വിലാസം",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },
          {
            "type": "TextInput", "name": "business_type",
            "label": "Type of Business / ബിസിനസ്സിന്റെ തരം",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },
          {
            "type": "TextInput", "name": "agreement_duration_months",
            "label": "Agreement Duration, months / കരാർ കാലാവധി, മാസം",
            "input-type": "number",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },

          {
            "type": "Footer",
            "label": "Submit / സമർപ്പിക്കുക",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "agreement_type": "${data.agreement_type}",
                "preferred_document_language": "${data.preferred_document_language}",
                "landlord_name": "${form.landlord_name}",
                "landlord_address": "${form.landlord_address}",
                "tenant_name": "${form.tenant_name}",
                "tenant_address": "${form.tenant_address}",
                "security_deposit": "${form.security_deposit}",
                "monthly_rent": "${form.monthly_rent}",
                "start_date": "${form.start_date}",
                "fee_due_day": "${form.fee_due_day}",
                "district": "${form.district}",
                "local_body_type": "${form.local_body_type}",
                "local_body_name": "${form.local_body_name}",
                "property_type": "${form.property_type}",
                "flat_name": "${form.flat_name}",
                "floor": "${form.floor}",
                "property_address": "${form.property_address}",
                "shop_address": "${form.shop_address}",
                "business_type": "${form.business_type}",
                "agreement_duration_months": "${form.agreement_duration_months}"
              }
            }
          }
        ]
      }
    }
  ]
}
