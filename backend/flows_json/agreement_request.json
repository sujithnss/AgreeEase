{
  "version": "6.0",
  "screens": [
    {
      "id": "WELCOME",
      "title": "AgreeEase",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Let's set up your agreement"
          },
          {
            "type": "TextBody",
            "text": "We'll ask a few quick questions to prepare your agreement."
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "TYPE" },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "TYPE",
      "title": "Type of Agreement",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "agreement_type",
            "label": "What type of agreement do you need?",
            "required": true,
            "data-source": [
              { "id": "rental_agreement", "title": "Rent Home" },
              { "id": "shop_agreement", "title": "Commercial" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "LANGUAGE" },
              "payload": {
                "agreement_type": "${form.agreement_type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LANGUAGE",
      "title": "Document Language",
      "data": {
        "agreement_type": { "type": "string", "__example__": "rental_agreement" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "preferred_document_language",
            "label": "Which language should the document be in?",
            "required": true,
            "data-source": [
              { "id": "english", "title": "English" },
              { "id": "malayalam", "title": "Malayalam" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "DETAILS" },
              "payload": {
                "agreement_type": "${data.agreement_type}",
                "preferred_document_language": "${form.preferred_document_language}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Agreement Details",
      "terminal": true,
      "data": {
        "agreement_type": { "type": "string", "__example__": "rental_agreement" },
        "preferred_document_language": { "type": "string", "__example__": "malayalam" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Agreement Details"
          },

          { "type": "TextInput", "name": "landlord_name", "label": "House Owner Name", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "landlord_address", "label": "House Owner Address", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "tenant_name", "label": "Tenant Name", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "tenant_address", "label": "Tenant Address", "input-type": "text", "required": true },
          { "type": "TextInput", "name": "security_deposit", "label": "Advance Amount (INR)", "input-type": "number", "required": true },
          { "type": "TextInput", "name": "monthly_rent", "label": "Rent Amount (INR, monthly)", "input-type": "number", "required": true },
          { "type": "DatePicker", "name": "start_date", "label": "Agreement Date", "required": true },

          {
            "type": "TextInput", "name": "fee_due_day",
            "label": "Rent Paid Day of Month, e.g. 5 or 10",
            "input-type": "number",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "TextInput", "name": "district",
            "label": "District",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "RadioButtonsGroup", "name": "local_body_type",
            "label": "Local Body Type",
            "data-source": [
              { "id": "grama_panchayat", "title": "Grama Panchayat" },
              { "id": "municipality", "title": "Municipality" },
              { "id": "corporation", "title": "Corporation" }
            ],
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "TextInput", "name": "local_body_name",
            "label": "Name of Local Body",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },
          {
            "type": "RadioButtonsGroup", "name": "property_type",
            "label": "Type of Property",
            "data-source": [
              { "id": "flat_apartment", "title": "Flat/Apartment" },
              { "id": "house", "title": "House" },
              { "id": "quarters", "title": "Quarters" }
            ],
            "visible": "`${data.agreement_type} == 'rental_agreement'`",
            "required": "`${data.agreement_type} == 'rental_agreement'`"
          },

          {
            "type": "TextInput", "name": "flat_name",
            "label": "Flat Name (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'flat_apartment')`"
          },
          {
            "type": "TextInput", "name": "quarters_name",
            "label": "Quarters Name (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'quarters')`"
          },
          {
            "type": "TextInput", "name": "floor_number",
            "label": "Floor Number (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'flat_apartment' || ${form.property_type} == 'quarters')`"
          },
          {
            "type": "TextInput", "name": "building_number",
            "label": "Building Number (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'flat_apartment' || ${form.property_type} == 'quarters')`"
          },
          {
            "type": "RadioButtonsGroup", "name": "house_portion",
            "label": "House Type",
            "data-source": [
              { "id": "ground_floor", "title": "Ground Floor House" },
              { "id": "top_floor", "title": "Top Floor House" },
              { "id": "single_house", "title": "Single House" }
            ],
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'house')`",
            "required": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'house')`"
          },
          {
            "type": "TextInput", "name": "house_number",
            "label": "House Number (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`(${data.agreement_type} == 'rental_agreement') && (${form.property_type} == 'house')`"
          },

          {
            "type": "TextInput", "name": "property_address",
            "label": "Door No. / Additional Address Details (optional)",
            "input-type": "text",
            "required": false,
            "visible": "`${data.agreement_type} == 'rental_agreement'`"
          },

          {
            "type": "TextInput", "name": "shop_address",
            "label": "Shop Address",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },
          {
            "type": "TextInput", "name": "business_type",
            "label": "Type of Business",
            "input-type": "text",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },
          {
            "type": "TextInput", "name": "agreement_duration_months",
            "label": "Agreement Duration, months",
            "input-type": "number",
            "visible": "`${data.agreement_type} == 'shop_agreement'`",
            "required": "`${data.agreement_type} == 'shop_agreement'`"
          },

          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "agreement_type": "${data.agreement_type}",
                "preferred_document_language": "${data.preferred_document_language}",
                "landlord_name": "${form.landlord_name}",
                "landlord_address": "${form.landlord_address}",
                "tenant_name": "${form.tenant_name}",
                "tenant_address": "${form.tenant_address}",
                "security_deposit": "${form.security_deposit}",
                "monthly_rent": "${form.monthly_rent}",
                "start_date": "${form.start_date}",
                "fee_due_day": "${form.fee_due_day}",
                "district": "${form.district}",
                "local_body_type": "${form.local_body_type}",
                "local_body_name": "${form.local_body_name}",
                "property_type": "${form.property_type}",
                "flat_name": "${form.flat_name}",
                "quarters_name": "${form.quarters_name}",
                "floor_number": "${form.floor_number}",
                "building_number": "${form.building_number}",
                "house_portion": "${form.house_portion}",
                "house_number": "${form.house_number}",
                "property_address": "${form.property_address}",
                "shop_address": "${form.shop_address}",
                "business_type": "${form.business_type}",
                "agreement_duration_months": "${form.agreement_duration_months}"
              }
            }
          }
        ]
      }
    }
  ]
}
